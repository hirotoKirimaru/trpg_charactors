{
  "name": "jest_practice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "test": "yarn test:e2e && yarn test:unit",
    "test:e2e": "vue-cli-service test:e2e",
    "test:unit": "vue-cli-service test:unit",
    "storybook": "start-storybook -p 9001 -c .storybook",
    "build-storybook": "build-storybook -s public",
    "2sketch": "story2sketch  ",
    "deploy": "firebase deploy"
  },
  "dependencies": {
    "core-js": "^3.46.0",
    "firebase": "^12.12.0",
    "register-service-worker": "^1.6.2",
    "vue": "^2.7.16",
    "vue-class-component": "^7.0.2",
    "vue-property-decorator": "^8.1.0",
    "vue-router": "^3.0.3",
    "vuetify": "^1.5.5",
    "vuex": "^3.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.4.5",
    "@storybook/vue": "^7.6.24",
    "@types/jest": "^27.5.2",
    "@vue/cli-plugin-babel": "^5.0.9",
    "@vue/cli-plugin-e2e-nightwatch": "^5.0.9",
    "@vue/cli-plugin-eslint": "^5.0.9",
    "@vue/cli-plugin-pwa": "^5.0.9",
    "@vue/cli-plugin-typescript": "^5.0.9",
    "@vue/cli-plugin-unit-jest": "^5.0.9",
    "@vue/cli-service": "^5.0.9",
    "@vue/eslint-config-prettier": "^7.1.0",
    "@vue/eslint-config-typescript": "^9.1.0",
    "@vue/test-utils": "^1.3.6",
    "babel-loader": "^8.0.6",
    "babel-preset-vue": "^2.0.2",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.7.1",
    "firebase-tools": "^15.15.0",
    "lint-staged": "^16.4.0",
    "story2sketch": "^1.6.0",
    "stylus": "^0.64.0",
    "stylus-loader": "^7.1.3",
    "ts-jest": "^27.1.5",
    "typescript": "~4.9.5",
    "vue-cli-plugin-storybook": "^0.6.1",
    "vue-cli-plugin-vuetify": "^0.5.0",
    "vue-loader": "^15.7.0",
    "vue-template-compiler": "^2.7.16",
    "vuetify-loader": "^1.9.2",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "^2.8.8",
    "@babel/eslint-parser": "^7.28.0",
    "jest": "^27.5.1",
    "@vue/vue2-jest": "^27.0.0",
    "babel-jest": "^27.5.1"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "@vue/prettier",
      "@vue/typescript"
    ],
    "rules": {},
    "parserOptions": {
      "parser": "@typescript-eslint/parser"
    }
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ],
  "jest": {
    "preset": "@vue/cli-plugin-unit-jest/presets/typescript-and-babel",
    "setupFiles": [
      "<rootDir>/tests/unit/setup.js"
    ]
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "vue-cli-service lint",
      "git add"
    ]
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "@surma/rollup-plugin-off-main-thread": {
      "ejs": "3.1.10"
    },
    "browserslist": "^4.29.4",
    "diff": "^5.2.2",
    "glob": {
      "minimatch": "3.1.5"
    },
    "mocha": {
      "js-yaml": "4.3.2",
      "minimatch": "4.2.6"
    },
    "nanoid": "^3.3.20",
    "nightwatch": {
      "ejs": "3.1.10",
      "semver": "7.8.5",
      "minimatch": "3.1.5"
    },
    "prismjs": "^1.30.0",
    "re2": "^1.27.0",
    "react-dev-utils": {
      "loader-utils": "1.4.2",
      "cross-spawn": "6.0.6"
    },
    "recursive-readdir": {
      "minimatch": "3.1.5"
    },
    "shell-quote": "^1.12.0"
  },
  "resolutions": {
    "**/@grpc/grpc-js": "^1.14.6",
    "**/browserslist": "^4.29.4",
    "**/diff": "^5.2.2",
    "**/mocha/js-yaml": "4.3.2",
    "**/mocha/minimatch": "4.2.6",
    "**/nanoid": "^3.3.20",
    "**/nightwatch/ejs": "3.1.10",
    "**/nightwatch/minimatch": "3.1.5",
    "**/nightwatch/semver": "7.8.5",
    "**/prismjs": "^1.30.0",
    "**/react-dev-utils/cross-spawn": "6.0.6",
    "**/react-dev-utils/loader-utils": "1.4.2",
    "**/recursive-readdir/minimatch": "3.1.5",
    "**/shell-quote": "^1.12.0"
  }
}
